# Copy to .env and fill in the two required values. .env is git-ignored; never commit it.

# Required. Compose refuses to start without them.
POSTGRES_PASSWORD=
VENDOR_WEBHOOK_SECRET=

# Ollama. Default: Ollama installed on your machine (needed on macOS for GPU acceleration).
# With the ollama-gpu compose profile (NVIDIA), use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:7b
# Must be a key of rag.store.models in the service configs. Changing it means a re-index.
EMBEDDING_MODEL=nomic-embed-text

# Observability. `make up-obs` turns this on and starts the grafana/otel-lgtm container.
OTEL_ENABLED=false

# Pipeline tuning. Each maps to an app property; see docs/configuration.md.
CHUNK_SIZE=400
CHUNK_OVERLAP=50
RETRIEVAL_TOP_N=20
RERANK_TOP_K=5
INGEST_SYNC_ON_STARTUP=true
INGEST_BLOCK_PRIVATE_NETWORKS=true
